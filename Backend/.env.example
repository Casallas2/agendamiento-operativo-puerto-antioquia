# ─── Aplicación ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
API_PREFIX=api/v1

# ─── Base de datos (PostgreSQL) ────────────────────────────────────────────────
DB_HOST=localhost
